# ---------- Postgres (obrigatório) ----------
# Mesmo banco do BackEnd-SiteCasa, ou um banco dedicado.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# ---------- Log ----------
LOG_LEVEL=info
# Se vazio, loga em stdout (recomendado em container)
#LOG_FILE=/usr/app/data/scrapper.log

# ---------- Loop de execução ----------
# De quanto em quanto tempo o processo verifica se existe busca vencida
TICK_SECONDS=60
# Intervalo padrão de cada busca nova (4x/dia)
DEFAULT_INTERVAL_MINUTES=360
JITTER_MIN_SECONDS=5
JITTER_MAX_SECONDS=12

# ---------- Scraper ----------
MAX_PAGES=100
REQUEST_TIMEOUT_MS=30000
# Alerta de queda de preço só a partir deste percentual (0 = qualquer queda)
MIN_DROP_PERCENT=0

# ---------- Seed (opcional) ----------
# Usado SOMENTE quando a tabela olx_monitor_busca está vazia. Depois disso,
# use o bot do Telegram (/olx add ...). URLs separadas por vírgula.
#SEED_URLS=https://www.olx.com.br/...,https://www.olx.com.br/...

# ---------- Telegram (fallback, opcional) ----------
# O normal é vir do banco: chats_telegram.token e usuarios.chatid_telegram.
#TELEGRAM_TOKEN=
#TELEGRAM_CHAT_ID=
